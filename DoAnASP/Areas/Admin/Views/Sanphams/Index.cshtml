@model DoAnASP.Areas.Admin.Controllers.PaginatedList<DoAnASP.Models.Sanpham>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Quản lý sản phẩm</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search & Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tìm kiếm</label>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tên sản phẩm, loại...">
            </div>
            <div class="col-md-3">
                <label class="form-label">Loại sản phẩm</label>
                <select name="loaiSp" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var loai in ViewBag.LoaiSpList)
                    {
                        var isSelected = (ViewBag.LoaiSp as string) == loai;
                        if (isSelected)
                        {
                            <option value="@loai" selected>@loai</option>
                        }
                        else
                        {
                            <option value="@loai">@loai</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Tìm kiếm
                </button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Products Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Loại</th>
                            <th>Giới tính</th>
                            <th>Số lượng</th>
                            <th>Giá</th>
                            <th>Ngày đăng</th>
                            <th style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                                    {
                                        <img src="@item.HinhAnh" alt="@item.TenSp" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium">@item.TenSp</div>
                                    @if (!string.IsNullOrEmpty(item.MoTa))
                                    {
                                        <small class="text-muted">@item.MoTa.Substring(0, Math.Min(50, item.MoTa.Length))@(item.MoTa.Length > 50 ? "..." : "")</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@item.LoaiSp</span></td>
                                <td>
                                    <span class="badge @(item.GtSp == "Nam" ? "bg-primary" : item.GtSp == "Nữ" ? "bg-danger" : "bg-info text-dark")">@item.GtSp</span>
                                </td>
                                <td>
                                    @if (item.Soluong == 0)
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                    else if (item.Soluong <= 5)
                                    {
                                        <span class="badge bg-warning text-dark">@item.Soluong (Sắp hết)</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-medium">@item.Soluong</span>
                                    }
                                </td>
                                <td class="fw-medium text-danger">@item.Gia.ToString("N0") đ</td>
                                <td>@item.NgayDang.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Pagination" class="px-3 py-3">
                    <ul class="pagination justify-content-center mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-searchString="@ViewBag.SearchString" asp-route-loaiSp="@ViewBag.LoaiSp">Trước</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">Trước</span></li>
                        }

                        @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <li class="page-item active"><span class="page-link">@i</span></li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.SearchString" asp-route-loaiSp="@ViewBag.LoaiSp">@i</a>
                                </li>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-searchString="@ViewBag.SearchString" asp-route-loaiSp="@ViewBag.LoaiSp">Sau</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link">Sau</span></li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-box-seam fs-1 text-muted"></i>
                <h5 class="mt-3 text-muted">Không tìm thấy sản phẩm</h5>
                <p class="text-muted">Thử thay đổi từ khóa tìm kiếm hoặc <a asp-action="Create" class="text-decoration-none">thêm sản phẩm mới</a></p>
            </div>
        }
    </div>
</div>