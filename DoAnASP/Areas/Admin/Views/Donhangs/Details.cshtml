@model DoAnASP.Models.Donhang

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id.ToString("D6");
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Chi tiết đơn hàng <span class="fw-normal text-muted">#@Model.Id.ToString("D6")</span></h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning me-2">
            <i class="bi bi-pencil me-1"></i> Cập nhật trạng thái
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Order Info -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Thông tin đơn hàng</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium text-muted">Mã đơn hàng</label>
                        <p class="fw-medium fs-5 mb-0">#@Model.Id.ToString("D6")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium text-muted">Ngày đặt</label>
                        <p class="fw-medium fs-5 mb-0">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium text-muted">Trạng thái</label>
                        <p class="mb-0">
                            @{
                                var badgeClass = Model.TrangThai switch
                                {
                                    "dang_xu_ly" => "bg-warning text-dark",
                                    "dang_giao" => "bg-info",
                                    "da_giao" => "bg-success",
                                    "huy" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                var statusText = Model.TrangThai switch
                                {
                                    "dang_xu_ly" => "Đang xử lý",
                                    "dang_giao" => "Đang giao",
                                    "da_giao" => "Đã giao",
                                    "huy" => "Đã hủy",
                                    _ => Model.TrangThai
                                };
                            }
                            <span class="badge @badgeClass px-3 py-2 fs-6">@statusText</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium text-muted">Phương thức thanh toán</label>
                        <p class="mb-0">
                            <span class="badge @(Model.PhuongThucTt == "cod" ? "bg-secondary" : "bg-primary") px-3 py-2">
                                @(Model.PhuongThucTt == "cod" ? "Thanh toán khi nhận (COD)" : Model.PhuongThucTt)
                            </span>
                        </p>
                    </div>
                </div>

                <hr>

                <h6 class="fw-medium">Thông tin người nhận</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-medium text-muted">Họ tên</label>
                        <p class="mb-0">@Model.TenNguoinhan</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-medium text-muted">Số điện thoại</label>
                        <p class="mb-0">@Model.Sdt</p>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-medium text-muted">Địa chỉ giao hàng</label>
                        <p class="mb-0">@Model.DiaChi</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.GhiChu))
                {
                    <hr>
                    <h6 class="fw-medium">Ghi chú</h6>
                    <p class="text-muted">@Model.GhiChu</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Order Summary -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Tóm tắt đơn hàng</h5>
            </div>
            <div class="card-body">
                @if (Model.Chitietdonhangs != null && Model.Chitietdonhangs.Any())
                {
                    foreach (var ct in Model.Chitietdonhangs)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <div>
                                <div class="fw-medium">@ct.IdSanphamNavigation?.TenSp</div>
                                <small class="text-muted">x @ct.SoLuong</small>
                            </div>
                            <div class="text-end">
                                <div class="fw-medium">@ct.DonGia.ToString("N0") đ</div>
                                <small class="text-muted">Thành tiền: @((ct.SoLuong * ct.DonGia).ToString("N0")) đ</small>
                            </div>
                        </div>
                        <hr class="my-2">
                    }
                }

                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>Tổng cộng</span>
                    <span class="text-danger">@Model.TongTien.ToString("N0") đ</span>
                </div>
            </div>
        </div>

        <!-- Customer Info -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Khách hàng</h5>
            </div>
            <div class="card-body">
                @if (Model.IdNguoidatNavigation != null)
                {
                    <div class="d-flex align-items-center mb-3">
                        <div class="avatar bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-person-fill text-white fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1">@Model.IdNguoidatNavigation.Name</h6>
                            <small class="text-muted">@Model.IdNguoidatNavigation.Email</small>
                        </div>
                    </div>

                    <div class="small text-muted">
                        <div><i class="bi bi-phone me-2"></i>@Model.IdNguoidatNavigation.Sdt</div>
                        <div><i class="bi bi-geo-alt me-2"></i>@Model.IdNguoidatNavigation.DiaChi</div>
                        <div><i class="bi bi-calendar me-2"></i>Thành viên từ: @Model.IdNguoidatNavigation.NgayTao.ToString("dd/MM/yyyy")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Order Items Details -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Chi tiết sản phẩm</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Chitietdonhangs != null && Model.Chitietdonhangs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;">Ảnh</th>
                                    <th>Sản phẩm</th>
                                    <th style="width: 120px;">Đơn giá</th>
                                    <th style="width: 100px;">Số lượng</th>
                                    <th style="width: 150px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in Model.Chitietdonhangs)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(ct.IdSanphamNavigation?.HinhAnh))
                                            {
                                                <img src="@ImageUrlHelper.GetUrl(ct.IdSanphamNavigation.HinhAnh)" alt="@ct.IdSanphamNavigation.TenSp" class="rounded" style="width: 60px; height: 60px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-medium">@ct.IdSanphamNavigation?.TenSp</div>
                                            <small class="text-muted">@ct.IdSanphamNavigation?.LoaiSp</small>
                                        </td>
                                        <td class="fw-medium">@ct.DonGia.ToString("N0") đ</td>
                                        <td>@ct.SoLuong</td>
                                        <td class="fw-medium text-danger">@((ct.SoLuong * ct.DonGia).ToString("N0")) đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
