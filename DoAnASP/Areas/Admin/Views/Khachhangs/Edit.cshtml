@model DoAnASP.Models.Taikhoan

@{
    ViewData["Title"] = "Chỉnh sửa khách hàng: " + Model.Name;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Chỉnh sửa khách hàng</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Thông tin khách hàng</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="NgayTao" />

                    <div class="row mb-3">
                        <label asp-for="Name" class="col-sm-2 col-form-label fw-medium"></label>
                        <div class="col-sm-10">
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Email" class="col-sm-2 col-form-label fw-medium"></label>
                        <div class="col-sm-10">
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Sdt" class="col-sm-2 col-form-label fw-medium"></label>
                        <div class="col-sm-10">
                            <input asp-for="Sdt" class="form-control" />
                            <span asp-validation-for="Sdt" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="DiaChi" class="col-sm-2 col-form-label fw-medium"></label>
                        <div class="col-sm-10">
                            <textarea asp-for="DiaChi" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Role" class="col-sm-2 col-form-label fw-medium"></label>
                        <div class="col-sm-10">
                            <select asp-for="Role" class="form-select">
                                <option value="user">User</option>
                                <option value="admin">Admin</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="bi bi-save me-1"></i> Cập nhật
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Hủy</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Reset Password Section -->
<div class="row mt-4">
    <div class="col-lg-8 mx-auto">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Đặt lại mật khẩu</h5>
            </div>
            <div class="card-body">
                <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn đặt lại mật khẩu cho khách hàng này?');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label fw-medium">Mật khẩu mới</label>
                        <div class="col-sm-10">
                            <input type="password" name="newPassword" class="form-control" required minlength="6" />
                            <div class="form-text">Tối thiểu 6 ký tự</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-key me-1"></i> Đặt lại mật khẩu
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}