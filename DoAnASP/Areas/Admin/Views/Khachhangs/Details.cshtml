@model DoAnASP.Models.Taikhoan

@{
    ViewData["Title"] = "Chi tiết khách hàng: " + Model.Name;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Chi tiết khách hàng</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning me-2">
            <i class="bi bi-pencil me-1"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <!-- Customer Profile Card -->
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Thông tin cá nhân</h5>
            </div>
            <div class="card-body text-center">
                <div class="avatar bg-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px;">
                    <i class="bi bi-person-fill text-white" style="font-size: 3rem;"></i>
                </div>
                <h4 class="mb-1">@Model.Name</h4>
                <p class="text-muted mb-3">@Model.Email</p>

                <div class="text-start small">
                    <div class="mb-2"><i class="bi bi-phone me-2 text-muted"></i><strong>SĐT:</strong> @Model.Sdt</div>
                    <div class="mb-2"><i class="bi bi-geo-alt me-2 text-muted"></i><strong>Địa chỉ:</strong> @Model.DiaChi</div>
                    <div class="mb-2"><i class="bi bi-person-badge me-2 text-muted"></i><strong>Vai trò:</strong>
                        <span class="badge @(Model.Role == "admin" ? "bg-danger" : "bg-primary") ms-2">@Model.Role</span>
                    </div>
                    <div class="mb-2"><i class="bi bi-calendar me-2 text-muted"></i><strong>Ngày tham gia:</strong> @Model.NgayTao.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8 mb-4">
        <!-- Stats Cards -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="card border-0 shadow-sm h-100 border-start border-primary border-3">
                    <div class="card-body text-center">
                        <i class="bi bi-cart-check fs-1 text-primary"></i>
                        <h5 class="mt-2 fw-bold">@ViewBag.TongDonHang</h5>
                        <p class="text-muted mb-0 small">Tổng đơn hàng</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card border-0 shadow-sm h-100 border-start border-success border-3">
                    <div class="card-body text-center">
                        <i class="bi bi-currency-dollar fs-1 text-success"></i>
                        <h5 class="mt-2 fw-bold text-success">@ViewBag.TongChiTieu.ToString("N0") đ</h5>
                        <p class="text-muted mb-0 small">Tổng chi tiêu</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card border-0 shadow-sm h-100 border-start border-info border-3">
                    <div class="card-body text-center">
                        <i class="bi bi-clock fs-1 text-info"></i>
                        <h5 class="mt-2 fw-bold">
                            @(ViewBag.DonHangGanNhat != null ? ViewBag.DonHangGanNhat.NgayDat.ToString("dd/MM/yyyy") : "Chưa có")
                        </h5>
                        <p class="text-muted mb-0 small">Đơn hàng gần nhất</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Orders -->
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Đơn hàng gần đây</h5>
                @if (Model.Donhangs != null && Model.Donhangs.Any())
                {
                    <a asp-controller="Donhangs" asp-action="Index" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.Donhangs != null && Model.Donhangs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Ngày đặt</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dh in Model.Donhangs.OrderByDescending(d => d.NgayDat).Take(10))
                                {
                                    var badgeClass = dh.TrangThai switch
                                    {
                                        "dang_xu_ly" => "bg-warning text-dark",
                                        "dang_giao" => "bg-info",
                                        "da_giao" => "bg-success",
                                        "huy" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                    <tr>
                                        <td>#@dh.Id.ToString("D6")</td>
                                        <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="fw-medium text-danger">@dh.TongTien.ToString("N0") đ</td>
                                        <td>
                                            <span class="badge @badgeClass px-2 py-1">
                                                @(dh.TrangThai switch
                                                {
                                                    "dang_xu_ly" => "Đang xử lý",
                                                    "dang_giao" => "Đang giao",
                                                    "da_giao" => "Đã giao",
                                                    "huy" => "Đã hủy",
                                                    _ => dh.TrangThai
                                                })
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-cart-x fs-1"></i>
                        <p class="mt-2 mb-0">Khách hàng chưa có đơn hàng nào</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>