@model IEnumerable<DoAnASP.Models.VSpBanchay>

@{
    ViewData["Title"] = "Sản phẩm bán chạy";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-graph-up-arrow"></i> Sản phẩm bán chạy</h1>
        <div class="btn-group btn-group-sm" role="group">
            <a href="@Url.Action("SanphamBanChay", "Thongke", new { top = 5 })" class="btn btn-outline-secondary @(ViewBag.Top == 5 ? "active" : "")">Top 5</a>
            <a href="@Url.Action("SanphamBanChay", "Thongke", new { top = 10 })" class="btn btn-outline-secondary @(ViewBag.Top == 10 ? "active" : "")">Top 10</a>
            <a href="@Url.Action("SanphamBanChay", "Thongke", new { top = 20 })" class="btn btn-outline-secondary @(ViewBag.Top == 20 ? "active" : "")">Top 20</a>
            <a href="@Url.Action("SanphamBanChay", "Thongke", new { top = 50 })" class="btn btn-outline-secondary @(ViewBag.Top == 50 ? "active" : "")">Top 50</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Top @ViewBag.Top sản phẩm bán chạy nhất</h5>
            <small class="text-muted">(Không tính đơn đã hủy)</small>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th scope="col" style="width: 60px;">#</th>
                                <th scope="col">Sản phẩm</th>
                                <th scope="col" class="text-center" style="width: 120px;">Đã bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle fw-bold text-center">
                                        @if (rank <= 3)
                                        {
                                            <span class="badge @(rank == 1 ? "bg-warning" : rank == 2 ? "bg-secondary" : "bg-danger")">@rank</span>
                                        }
                                        else
                                        {
                                            <span>@rank</span>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <img src="/images/@item.TenSp" alt="@item.TenSp" class="rounded me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/50x50?text=No+Image'" />
                                            <span>@item.TenSp</span>
                                        </div>
                                    </td>
                                    <td class="align-middle text-center text-success fw-bold">@item.DaBan</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-1 text-muted"></i>
                    <h3 class="mt-3 text-muted">Chưa có dữ liệu bán hàng</h3>
                </div>
            }
        </div>
    </div>
</div>