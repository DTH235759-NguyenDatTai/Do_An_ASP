@model DoAnASP.Models.Sanpham

@{
    ViewData["Title"] = Model?.TenSp ?? "Chi tiết sản phẩm";
    var relatedProducts = ViewBag.RelatedProducts as System.Collections.Generic.List<DoAnASP.Models.Sanpham>
        ?? new System.Collections.Generic.List<DoAnASP.Models.Sanpham>();

    // Helper function to get correct image URL
    Func<string?, string> GetImageUrl = (hinhAnh) =>
    {
        if (string.IsNullOrEmpty(hinhAnh))
            return "https://via.placeholder.com/500x400?text=No+Image";

        if (hinhAnh.StartsWith("http") || hinhAnh.StartsWith("/"))
            return hinhAnh;

        return "/images/" + hinhAnh;
    };
}

@if (Model == null)
{
    <div class="container py-5">
        <div class="alert alert-danger text-center">
            <h4>Không tìm thấy sản phẩm</h4>
            <a href="@Url.Action("Index", "Sanphams")" class="btn btn-primary">Quay lại danh sách sản phẩm</a>
        </div>
    </div>
}
else
{
<div class="container py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Sanphams")">Sản phẩm</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Sanphams", new { loaiSp = Model.LoaiSp })">@Model.LoaiSp</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.TenSp</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Product Gallery -->
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div id="productMainImage" class="carousel slide" data-bs-ride="false">
                        <div class="carousel-inner rounded">
                            <div class="carousel-item active">
                                <img src="@GetImageUrl(Model.HinhAnh)" class="d-block w-100" alt="@Model.TenSp"
                                     style="height: 500px; object-fit: contain; background: #f8f9fa;"
                                     onerror="this.src='https://via.placeholder.com/600x500?text=No+Image'" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Product Info -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 p-lg-5">
                    <!-- Category Badge -->
                    <div class="mb-3">
                        <span class="badge bg-secondary fs-6 px-3 py-2">@Model.LoaiSp</span>
                        <span class="badge bg-info text-dark fs-6 px-3 py-2 ms-2">@Model.GtSp</span>
                    </div>

                    <!-- Product Name -->
                    <h1 class="fw-bold mb-3">@Model.TenSp</h1>

                    <!-- Price -->
                    <div class="mb-4">
                        <span class="text-danger fw-bold fs-2">@Model.Gia.ToString("N0") đ</span>
                    </div>

                    <!-- Stock Status -->
                    <div class="mb-4">
                        @if (Model.Soluong > 0)
                        {
                            <span class="badge bg-success fs-6 px-3 py-2">
                                <i class="bi bi-check-circle"></i> Còn hàng (@Model.Soluong sản phẩm)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6 px-3 py-2">
                                <i class="bi bi-x-circle"></i> Hết hàng
                            </span>
                        }
                    </div>

                    <!-- Description -->
                    @if (!string.IsNullOrEmpty(Model.MoTa))
                    {
                        <div class="mb-4 p-3 bg-light rounded">
                            <h6 class="fw-bold mb-2"><i class="bi bi-info-circle"></i> Mô tả sản phẩm</h6>
                            <p class="mb-0 text-muted">@Model.MoTa</p>
                        </div>
                    }

                    <!-- Quantity & Add to Cart -->
                    @if (Model.Soluong > 0)
                    {
                        <div class="d-flex gap-3 mb-4">
                            <div class="input-group" style="max-width: 150px;">
                                <label for="quantity" class="input-group-text fw-medium">Số lượng</label>
                                <input type="number" class="form-control text-center" id="quantity" name="quantity" value="1" min="1" max="@Model.Soluong" />
                            </div>
                            <button type="button" class="btn btn-primary btn-lg flex-grow-1" onclick="addToCart(@Model.Id, document.getElementById('quantity').value)">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                            </button>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary flex-grow-1" onclick="buyNow(@Model.Id, document.getElementById('quantity').value)">
                                <i class="bi bi-lightning"></i> Mua ngay
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle"></i> Sản phẩm hiện đã hết hàng.
                        </div>
                    }

                    <hr />

                    <!-- Product Meta -->
                    <div class="row text-muted small">
                        <div class="col-6">
                            <p class="mb-1"><strong>Đã bán:</strong> <span id="soldCount">-</span></p>
                        </div>
                        <div class="col-6">
                            <p class="mb-1"><strong>Ngày đăng:</strong> @Model.NgayDang.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (relatedProducts.Count > 0)
    {
        <div class="mt-5">
            <h3 class="mb-4"><i class="bi bi-heart"></i> Sản phẩm liên quan</h3>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var item in relatedProducts)
                {
                    <div class="col">
                        <div class="card product-card h-100 border-0 shadow-sm">
                            <a href="@Url.Action("Details", "Sanphams", new { id = item.Id })" class="text-decoration-none text-dark">
                                <img src="@GetImageUrl(item.HinhAnh ?? string.Empty)" class="card-img-top product-img" alt="@item.TenSp"
                                     onerror="this.src='https://via.placeholder.com/300x200?text=No+Image'" />
                            </a>
                            @if (item.Soluong <= 0)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2">Hết hàng</span>
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-secondary mb-2 align-self-start">@item.LoaiSp</span>
                                <h5 class="card-title">
                                    <a href="@Url.Action("Details", "Sanphams", new { id = item.Id })" class="text-dark text-decoration-none">
                                        @item.TenSp
                                    </a>
                                </h5>
                                <div class="d-flex justify-content-between align-items-center mb-3 mt-auto">
                                    <span class="text-danger fw-bold fs-5">@item.Gia.ToString("N0") đ</span>
                                    <small class="text-muted">@(item.Soluong > 0 ? $"Còn {item.Soluong}" : "Hết hàng")</small>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Details", "Sanphams", new { id = item.Id })"
                                       class="btn btn-outline-primary flex-grow-1">
                                        <i class="bi bi-eye"></i> Xem chi tiết
                                    </a>
                                    @if (item.Soluong > 0)
                                    {
                                        <button type="button" class="btn btn-primary flex-grow-1"
                                                onclick="addToCart(@item.Id)">
                                            <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary flex-grow-1" disabled>
                                            <i class="bi bi-x-circle"></i> Hết hàng
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @if (Model != null)
    {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Fetch sold count for this product
            fetch('/Sanphams/GetSoldCount/@Model.Id')
                .then(response => response.json())
                .then(data => {
                    const el = document.getElementById('soldCount');
                    if (el) {
                        el.textContent = data.count + ' sản phẩm';
                    }
                })
                .catch(() => {
                    const el = document.getElementById('soldCount');
                    if (el) el.textContent = 'Đang cập nhật...';
                });

            // Buy now - redirect to checkout with single item
            window.buyNow = function (productId, quantity) {
                // Add to cart first, then redirect to checkout
                fetch('/Cart/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('#antiforgery-form input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: `productId=${productId}&quantity=${quantity}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = '/Orders/Checkout';
                    } else {
                        alert(data.message || 'Không thể thêm vào giỏ hàng');
                    }
                })
                .catch(() => alert('Đã có lỗi xảy ra'));
            };
        });
    </script>
    }
}
