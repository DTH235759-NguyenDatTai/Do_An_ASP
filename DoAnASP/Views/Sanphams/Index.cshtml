@model IEnumerable<DoAnASP.Models.Sanpham>

@{
    ViewData["Title"] = "Danh sách sản phẩm";

    // Helper function to get correct image URL
    Func<string, string> GetImageUrl = (hinhAnh) =>
    {
        if (string.IsNullOrEmpty(hinhAnh))
            return "https://via.placeholder.com/300x200?text=No+Image";

        // If it's already a full URL or absolute path starting with /, use as-is
        if (hinhAnh.StartsWith("http") || hinhAnh.StartsWith("/"))
            return hinhAnh;

        // Otherwise, assume it's a filename in wwwroot/images
        return "/images/" + hinhAnh;
    };
}

<!-- Search and Filter Bar -->
<div class="row mb-4">
    <div class="col-12">
        <form method="get" action="@Url.Action("Index", "Sanphams")" class="row g-3">
            <div class="col-md-6">
                <label for="searchString" class="form-label visually-hidden">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" id="searchString" name="searchString"
                           placeholder="Tìm kiếm sản phẩm..." value="@ViewBag.SearchString" />
                </div>
            </div>
            <div class="col-md-3">
                <label for="loaiSp" class="form-label visually-hidden">Danh mục</label>
                <select class="form-select" id="loaiSp" name="loaiSp">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var loai in ViewBag.LoaiSpList)
                    {
                        var isSelected = ViewBag.LoaiSp == loai;
                        <option value="@loai" selected="@isSelected">@loai</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Product Count and Sort -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">
        Hiển thị <strong>@ViewBag.TotalItems</strong> sản phẩm
    </div>
    <div class="btn-group btn-group-sm" role="group">
        <a href="@Url.Action("Index", "Sanphams", new { searchString = ViewBag.SearchString, loaiSp = ViewBag.LoaiSp, page = 1 })"
           class="btn btn-outline-secondary @(ViewBag.CurrentPage == 1 ? "active" : "")">Mới nhất</a>
        <a href="@Url.Action("Index", "Sanphams", new { searchString = ViewBag.SearchString, loaiSp = ViewBag.LoaiSp, page = 1, sort = "price_asc" })"
           class="btn btn-outline-secondary">Giá thấp đến cao</a>
        <a href="@Url.Action("Index", "Sanphams", new { searchString = ViewBag.SearchString, loaiSp = ViewBag.LoaiSp, page = 1, sort = "price_desc" })"
           class="btn btn-outline-secondary">Giá cao đến thấp</a>
    </div>
</div>

<!-- Product Grid -->
@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card product-card h-100 border-0 shadow-sm">
                    <!-- Product Image -->
                    <a href="@Url.Action("Details", "Sanphams", new { id = item.Id })" class="text-decoration-none text-dark">
                        <img src="@GetImageUrl(item.HinhAnh ?? string.Empty)" class="card-img-top product-img" alt="@item.TenSp"
                             onerror="this.src='https://via.placeholder.com/300x200?text=No+Image'" />
                    </a>

                    <!-- Badge for out of stock -->
                    @if (item.Soluong <= 0)
                    {
                        <span class="badge bg-danger position-absolute top-0 end-0 m-2">Hết hàng</span>
                    }

                    <div class="card-body d-flex flex-column">
                        <!-- Category -->
                        <span class="badge bg-secondary mb-2 align-self-start">@item.LoaiSp</span>

                        <!-- Product Name -->
                        <h5 class="card-title">
                            <a href="@Url.Action("Details", "Sanphams", new { id = item.Id })" class="text-dark text-decoration-none">
                                @item.TenSp
                            </a>
                        </h5>

                        <!-- Description (truncated) -->
                        @if (!string.IsNullOrEmpty(item.MoTa))
                        {
                            <p class="card-text text-muted small flex-grow-1">
                                @(item.MoTa.Length > 80 ? item.MoTa.Substring(0, 80) + "..." : item.MoTa)
                            </p>
                        }

                        <!-- Price and Stock -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-danger fw-bold fs-5">@item.Gia.ToString("N0") đ</span>
                            <small class="text-muted">@(item.Soluong > 0 ? $"Còn {item.Soluong}" : "Hết hàng")</small>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Details", "Sanphams", new { id = item.Id })"
                               class="btn btn-outline-primary flex-grow-1">
                                <i class="bi bi-eye"></i> Xem chi tiết
                            </a>
                            @if (item.Soluong > 0)
                            {
                                <button type="button" class="btn btn-primary flex-grow-1"
                                        onclick="addToCart(@item.Id)">
                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary flex-grow-1" disabled>
                                    <i class="bi bi-x-circle"></i> Hết hàng
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Product pagination" class="mt-5">
            <ul class="pagination justify-content-center">
                <!-- Previous -->
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", "Sanphams", new { searchString = ViewBag.SearchString, loaiSp = ViewBag.LoaiSp, page = ViewBag.CurrentPage - 1 })"
                       aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                <!-- Page Numbers -->
                @{
                    int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                    int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);

                    if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="@Url.Action("Index", "Sanphams", new { searchString = ViewBag.SearchString, loaiSp = ViewBag.LoaiSp, page = 1 })">1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", "Sanphams", new { searchString = ViewBag.SearchString, loaiSp = ViewBag.LoaiSp, page = i })">@i</a>
                        </li>
                    }

                    if (endPage < ViewBag.TotalPages)
                    {
                        if (endPage < ViewBag.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link"
                               href="@Url.Action("Index", "Sanphams", new { searchString = ViewBag.SearchString, loaiSp = ViewBag.LoaiSp, page = ViewBag.TotalPages })">@ViewBag.TotalPages</a>
                        </li>
                    }
                }

                <!-- Next -->
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", "Sanphams", new { searchString = ViewBag.SearchString, loaiSp = ViewBag.LoaiSp, page = ViewBag.CurrentPage + 1 })"
                       aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-search display-1 text-muted"></i>
        <h3 class="mt-3 text-muted">Không tìm thấy sản phẩm</h3>
        <p class="text-muted">Thử thay đổi từ khóa tìm kiếm hoặc chọn danh mục khác.</p>
        <a href="@Url.Action("Index", "Sanphams")" class="btn btn-primary">Xem tất cả sản phẩm</a>
    </div>
}