@model List<DoAnASP.Controllers.CartItem>

@{
    // Helper function to get correct image URL
    Func<string, string> GetImageUrl = (hinhAnh) =>
    {
        if (string.IsNullOrEmpty(hinhAnh))
            return "https://via.placeholder.com/50x40?text=No+Image";

        // If it's already a full URL or absolute path starting with /, use as-is
        if (hinhAnh.StartsWith("http") || hinhAnh.StartsWith("/"))
            return hinhAnh;

        // Otherwise, assume it's a filename in wwwroot/images
        return "/images/" + hinhAnh;
    };
}

@if (Model != null && Model.Any())
{
    <div class="dropdown-menu dropdown-menu-end shadow-lg" style="width: 350px; max-height: 400px; overflow-y: auto;">
        <div class="dropdown-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bi-cart3"></i> Giỏ hàng (@Model.Sum(i => i.Quantity))</h6>
        </div>

        @foreach (var item in Model)
        {
            <div class="dropdown-item d-flex align-items-center p-2 border-bottom">
                <img src="@GetImageUrl(item.ImageUrl)"
                     alt="@item.ProductName" class="rounded me-2" style="width: 50px; height: 40px; object-fit: cover;" />
                <div class="flex-grow-1">
                    <small class="text-truncate d-block">@item.ProductName</small>
                    <small class="text-muted">@item.Quantity x @item.Price.ToString("N0") đ</small>
                </div>
                <span class="text-danger fw-bold">@item.Total.ToString("N0") đ</span>
            </div>
        }

        <div class="dropdown-divider"></div>
        <div class="dropdown-item d-flex justify-content-between">
            <strong>Tổng cộng:</strong>
            <strong class="text-danger">@Model.Sum(i => i.Total).ToString("N0") đ</strong>
        </div>
        <div class="dropdown-footer p-2">
            <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-primary w-100 mb-2">
                <i class="bi bi-cart"></i> Xem giỏ hàng
            </a>
            <a href="@Url.Action("Checkout", "Donhangs")" class="btn btn-primary w-100">
                <i class="bi bi-credit-card"></i> Thanh toán
            </a>
        </div>
    </div>
}
else
{
    <div class="dropdown-menu dropdown-menu-end shadow-lg" style="width: 280px;">
        <div class="dropdown-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bi-cart3"></i> Giỏ hàng</h6>
        </div>
        <div class="dropdown-item text-center py-4 text-muted">
            <i class="bi bi-cart-x display-6"></i>
            <p class="mb-0 mt-2">Giỏ hàng trống</p>
        </div>
        <div class="dropdown-footer p-2">
            <a href="@Url.Action("Index", "Sanphams")" class="btn btn-primary w-100">
                <i class="bi bi-bag-plus"></i> Mua sắm ngay
            </a>
        </div>
    </div>
}