@{
    ViewData["Title"] = "Đăng ký";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-3">Đăng ký</h2>
        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label class="form-label">Họ tên</label>
                <input name="name" class="form-control" required maxlength="100" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input name="email" type="email" class="form-control" required maxlength="100" />
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu (tối thiểu 6 ký tự)</label>
                <input name="password" type="password" class="form-control" required minlength="6" />
            </div>
            <div class="mb-3">
                <label class="form-label">Số điện thoại</label>
                <input name="sdt" class="form-control" maxlength="15" />
            </div>
            <div class="mb-3">
                <label class="form-label">Địa chỉ</label>
                <input name="diaChi" class="form-control" maxlength="255" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
        </form>
        <p class="mt-3 text-center">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
    </div>
</div>