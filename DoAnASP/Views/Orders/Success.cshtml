@model DoAnASP.Models.Donhang

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Success Message -->
            <div class="text-center mb-5">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                </div>
                <h1 class="fw-bold">Đặt hàng thành công!</h1>
                <p class="text-muted fs-5">Cảm ơn bạn đã mua sắm tại DoAnASP</p>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0"><i class="bi bi-receipt"></i> Thông tin đơn hàng <span class="text-primary ms-2">#@Model.Id</span></h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Trạng thái:</strong> <span class="badge bg-warning text-dark">@Model.TrangThai</span></p>
                            <p class="mb-1"><strong>Ngày đặt:</strong> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-1"><strong>Phương thức TT:</strong> @(Model.PhuongThucTt == "cod" ? "Thanh toán khi nhận hàng (COD)" : "Chuyển khoản")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Người nhận:</strong> @Model.TenNguoinhan</p>
                            <p class="mb-1"><strong>SĐT:</strong> @Model.Sdt</p>
                            <p class="mb-1"><strong>Địa chỉ:</strong> @Model.DiaChi</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                    {
                        <div class="mb-3">
                            <strong>Ghi chú:</strong> @Model.GhiChu
                        </div>
                    }

                    <hr />

                    <!-- Order Items -->
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th scope="col">Sản phẩm</th>
                                    <th scope="col" class="text-center" style="width: 80px;">SL</th>
                                    <th scope="col" class="text-end" style="width: 150px;">Đơn giá</th>
                                    <th scope="col" class="text-end" style="width: 150px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Chitietdonhangs)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="/images/@item.IdSanphamNavigation.HinhAnh" alt="@item.IdSanphamNavigation.TenSp"
                                                     class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;"
                                                     onerror="this.src='https://via.placeholder.com/40x40?text=No+Image'" />
                                                <span>@item.IdSanphamNavigation.TenSp</span>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.SoLuong</td>
                                        <td class="text-end">@item.DonGia.ToString("N0") đ</td>
                                        <td class="text-end fw-medium">@(item.SoLuong * item.DonGia).ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <th colspan="3" class="text-end">Tổng cộng</th>
                                    <th class="text-end text-danger fw-bold">@Model.TongTien.ToString("N0") đ</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a href="@Url.Action("MyOrders", "Orders")" class="btn btn-primary">
                    <i class="bi bi-list-ul"></i> Xem đơn hàng của tôi
                </a>
                <a href="@Url.Action("Index", "Sanphams")" class="btn btn-outline-secondary">
                    <i class="bi bi-bag-plus"></i> Tiếp tục mua sắm
                </a>
            </div>
        </div>
    </div>
</div>