@model DoAnASP.Models.Donhang

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0"><i class="bi bi-receipt"></i> Chi tiết đơn hàng <span class="text-primary">#@Model.Id</span></h1>
                <a href="@Url.Action("MyOrders", "Orders")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0">Thông tin đơn hàng</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Trạng thái:</strong>
                                <span class="badge @(Model.TrangThai == "dang_xu_ly" ? "bg-warning text-dark" : Model.TrangThai == "da_giao" ? "bg-success" : Model.TrangThai == "huy" ? "bg-secondary" : "bg-info") ms-2">
                                    @(Model.TrangThai == "dang_xu_ly" ? "Đang xử lý" : Model.TrangThai == "da_giao" ? "Đã giao" : Model.TrangThai == "huy" ? "Đã hủy" : Model.TrangThai)
                                </span>
                            </p>
                            <p class="mb-1"><strong>Ngày đặt:</strong> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-1"><strong>Phương thức thanh toán:</strong> @(Model.PhuongThucTt == "cod" ? "Thanh toán khi nhận hàng (COD)" : "Chuyển khoản")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Người nhận:</strong> @Model.TenNguoinhan</p>
                            <p class="mb-1"><strong>Số điện thoại:</strong> @Model.Sdt</p>
                            <p class="mb-1"><strong>Địa chỉ giao hàng:</strong> @Model.DiaChi</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                    {
                        <hr />
                        <p class="mb-0"><strong>Ghi chú:</strong> @Model.GhiChu</p>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0">Sản phẩm trong đơn hàng</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th scope="col" style="width: 80px;">Ảnh</th>
                                    <th scope="col">Sản phẩm</th>
                                    <th scope="col" class="text-center" style="width: 80px;">SL</th>
                                    <th scope="col" class="text-end" style="width: 150px;">Đơn giá</th>
                                    <th scope="col" class="text-end" style="width: 150px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Chitietdonhangs)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <img src="/images/@item.IdSanphamNavigation.HinhAnh" alt="@item.IdSanphamNavigation.TenSp"
                                                 class="rounded" style="width: 60px; height: 60px; object-fit: cover;"
                                                 onerror="this.src='https://via.placeholder.com/60x60?text=No+Image'" />
                                        </td>
                                        <td class="align-middle">
                                            <div class="fw-medium">@item.IdSanphamNavigation.TenSp</div>
                                        </td>
                                        <td class="align-middle text-center">@item.SoLuong</td>
                                        <td class="align-middle text-end">@item.DonGia.ToString("N0") đ</td>
                                        <td class="align-middle text-end fw-medium">@((item.SoLuong * item.DonGia).ToString("N0")) đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <th colspan="4" class="text-end">Tổng cộng</th>
                                    <th class="text-end text-danger fw-bold fs-5">@Model.TongTien.ToString("N0") đ</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            @if (Model.TrangThai == "dang_xu_ly")
            {
                <div class="d-grid">
                    <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này? Tồn kho sẽ được hoàn lại.');">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="bi bi-x-circle"></i> Hủy đơn hàng
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>
