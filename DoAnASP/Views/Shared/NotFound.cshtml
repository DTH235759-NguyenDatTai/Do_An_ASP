@{
    ViewData["Title"] = "Không tìm thấy trang";
    Layout = "_LayoutCustomer";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="mb-4">
                <span class="display-1 fw-bold text-muted">404</span>
            </div>
            <h1 class="h2 fw-bold mb-3">Không tìm thấy trang</h1>
            <p class="lead text-muted mb-4">Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển.</p>

            <div class="d-flex gap-2 justify-content-center">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                    <i class="bi bi-house me-1"></i> Về trang chủ
                </a>
                <a href="@Url.Action("Index", "Sanphams")" class="btn btn-outline-primary">
                    <i class="bi bi-shop me-1"></i> Xem sản phẩm
                </a>
                <button onclick="history.back()" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </button>
            </div>
        </div>
    </div>
</div>