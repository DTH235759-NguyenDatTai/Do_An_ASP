<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    if (User.IsInRole("admin"))
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang quản trị</a>
        </li>
    }
    <li class="nav-item">
        <span class="nav-link text-white">Xin chào, @User.Identity.Name</span>
    </li>
    <li class="nav-item">
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-white">Đăng xuất</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
    </li>
}
</ul>