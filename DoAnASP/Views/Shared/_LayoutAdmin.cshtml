<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Admin Dashboard - DoAnASP">
    <meta name="author" content="DoAnASP">

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="shortcut icon" href="~/favicon.ico" />

    <title>Trang quản trị - DoAnASP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="~/css/admin.css" rel="stylesheet">
</head>

<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar js-sidebar">
            <div class="sidebar-content js-simplebar">
                <a class="sidebar-brand" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                    <span class="align-middle fw-bold fs-4">DoAnASP Admin</span>
                </a>

                <ul class="sidebar-nav">
                    <li class="sidebar-header text-primary">
                        TỔNG QUAN
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                            <i class="bi bi-speedometer2 align-middle me-2"></i> <span class="align-middle">Bảng điều khiển</span>
                        </a>
                    </li>

                    <li class="sidebar-header text-primary">
                        QUẢN LÝ SẢN PHẨM
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Sanphams", new { area = "Admin" })">
                            <i class="bi bi-box-seam align-middle me-2"></i> <span class="align-middle">Danh sách sản phẩm</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Create", "Sanphams", new { area = "Admin" })">
                            <i class="bi bi-plus-circle align-middle me-2"></i> <span class="align-middle">Thêm sản phẩm</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Danhmucs", new { area = "Admin" })">
                            <i class="bi bi-tags align-middle me-2"></i> <span class="align-middle">Quản lý danh mục</span>
                        </a>
                    </li>

                    <li class="sidebar-header text-primary">
                        QUẢN LÝ ĐƠN HÀNG
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Donhangs", new { area = "Admin" })">
                            <i class="bi bi-cart-check align-middle me-2"></i> <span class="align-middle">Tất cả đơn hàng</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Donhangs", new { area = "Admin", status = "dang_xu_ly" })">
                            <i class="bi bi-hourglass-split align-middle me-2"></i> <span class="align-middle">Đang xử lý</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Donhangs", new { area = "Admin", status = "da_giao" })">
                            <i class="bi bi-check-circle align-middle me-2"></i> <span class="align-middle">Đã giao</span>
                        </a>
                    </li>

                    <li class="sidebar-header text-primary">
                        KHÁCH HÀNG & TÀI KHOẢN
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Khachhangs", new { area = "Admin" })">
                            <i class="bi bi-people align-middle me-2"></i> <span class="align-middle">Quản lý khách hàng</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Taikhoans", new { area = "Admin" })">
                            <i class="bi bi-person-badge align-middle me-2"></i> <span class="align-middle">Quản lý tài khoản</span>
                        </a>
                    </li>

                    <li class="sidebar-header text-primary">
                        THỐNG KÊ & BÁO CÁO
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Thongke", new { area = "Admin" })">
                            <i class="bi bi-bar-chart align-middle me-2"></i> <span class="align-middle">Doanh thu</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("SanphamBanChay", "Thongke", new { area = "Admin" })">
                            <i class="bi bi-graph-up-arrow align-middle me-2"></i> <span class="align-middle">Sản phẩm bán chạy</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="main">
            <nav class="navbar navbar-expand navbar-light navbar-bg bg-white border-bottom shadow-sm">
                <a class="sidebar-toggle js-sidebar-toggle me-3">
                    <i class="bi bi-list fs-4"></i>
                </a>

                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav navbar-align ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-icon dropdown-toggle" href="#" id="alertsDropdown" data-bs-toggle="dropdown">
                                <div class="position-relative">
                                    <i class="bi bi-bell align-middle fs-5"></i>
                                    <span class="indicator badge bg-danger">3</span>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end py-0" aria-labelledby="alertsDropdown">
                                <div class="dropdown-menu-header p-3 border-bottom">
                                    <strong>Thông báo mới</strong>
                                </div>
                                <div class="list-group list-group-flush">
                                    <a href="#" class="list-group-item list-group-item-action">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3 text-danger"><i class="bi bi-exclamation-triangle-fill fs-4"></i></div>
                                            <div>
                                                <div class="fw-medium">Đơn hàng mới cần xử lý</div>
                                                <div class="text-muted small">Có 5 đơn hàng đang chờ xác nhận</div>
                                                <div class="text-muted small">5 phút trước</div>
                                            </div>
                                        </div>
                                    </a>
                                    <a href="#" class="list-group-item list-group-item-action">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3 text-warning"><i class="bi bi-exclamation-circle-fill fs-4"></i></div>
                                            <div>
                                                <div class="fw-medium">Sản phẩm sắp hết hàng</div>
                                                <div class="text-muted small">3 sản phẩm còn dưới 5 единиц</div>
                                                <div class="text-muted small">15 phút trước</div>
                                            </div>
                                        </div>
                                    </a>
                                    <a href="#" class="list-group-item list-group-item-action">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3 text-primary"><i class="bi bi-info-circle-fill fs-4"></i></div>
                                            <div>
                                                <div class="fw-medium">Khách hàng mới đăng ký</div>
                                                <div class="text-muted small">Nguyễn Văn A vừa tạo tài khoản</div>
                                                <div class="text-muted small">1 giờ trước</div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <div class="dropdown-menu-footer p-3 border-top">
                                    <a href="#" class="text-decoration-none">Xem tất cả thông báo</a>
                                </div>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-icon dropdown-toggle" href="#" id="messagesDropdown" data-bs-toggle="dropdown">
                                <div class="position-relative">
                                    <i class="bi bi-chat-dots align-middle fs-5"></i>
                                    <span class="indicator badge bg-danger">2</span>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end py-0" aria-labelledby="messagesDropdown">
                                <div class="dropdown-menu-header p-3 border-bottom">
                                    <strong>Tin nhắn mới</strong>
                                </div>
                                <div class="list-group list-group-flush">
                                    <a href="#" class="list-group-item list-group-item-action">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                <div class="avatar bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-person-fill text-white"></i>
                                                </div>
                                            </div>
                                            <div>
                                                <div class="fw-medium">Khách hàng</div>
                                                <div class="text-muted small">Hỏi về chính sách đổi trả</div>
                                                <div class="text-muted small">10 phút trước</div>
                                            </div>
                                        </div>
                                    </a>
                                    <a href="#" class="list-group-item list-group-item-action">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                <div class="avatar bg-info rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-person-fill text-white"></i>
                                                </div>
                                            </div>
                                            <div>
                                                <div class="fw-medium">Khách hàng</div>
                                                <div class="text-muted small">Muốn hủy đơn hàng #1234</div>
                                                <div class="text-muted small">30 phút trước</div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <div class="dropdown-menu-footer p-3 border-top">
                                    <a href="#" class="text-decoration-none">Xem tất cả tin nhắn</a>
                                </div>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                <div class="avatar bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                    <i class="bi bi-person-fill text-white"></i>
                                </div>
                                <span class="text-dark d-none d-sm-inline-block fw-medium">Admin</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i> Hồ sơ</a>
                                <a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i> Cài đặt</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="@Url.Action("Index", "Home", new { area = "" })" target="_blank"><i class="bi bi-box-arrow-up-right me-2"></i> Xem trang khách</a>
                                <div class="dropdown-divider"></div>
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                                </form>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="content">
                <div class="container-fluid p-4">
                    @RenderBody()
                </div>
            </main>

            <footer class="footer bg-light border-top">
                <div class="container-fluid">
                    <div class="row text-muted">
                        <div class="col-6 text-start">
                            <p class="mb-0">
                                <a class="text-muted" href="#"><strong>DoAnASP</strong></a> - Hệ thống quản trị
                            </p>
                        </div>
                        <div class="col-6 text-end">
                            <ul class="list-inline mb-0">
                                <li class="list-inline-item">
                                    <a class="text-muted" href="#">Hỗ trợ</a>
                                </li>
                                <li class="list-inline-item">
                                    <a class="text-muted" href="#">Tài liệu</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/simplebar@6.2.5/dist/simplebar.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>