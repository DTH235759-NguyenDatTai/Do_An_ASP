@model IEnumerable<DoAnASP.Models.Chitietdonhang>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdDonhang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdSanpham)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SoLuong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DonGia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdDonhangNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdSanphamNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdDonhang)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdSanpham)
            </td>
            <td>
                @Html.DisplayFor(model => item.SoLuong)
            </td>
            <td>
                @Html.DisplayFor(model => item.DonGia)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdDonhangNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdSanphamNavigation)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
